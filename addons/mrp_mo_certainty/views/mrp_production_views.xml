<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add certainty field to MO form view -->
    <record id="mrp_production_form_view_certainty" model="ir.ui.view">
        <field name="name">mrp.production.form.certainty</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <!-- Add certainty field after user_id -->
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="certainty" 
                       widget="selection"
                       readonly="state not in ['draft', 'quoted']"/>
            </xpath>
        </field>
    </record>

    <!-- Add certainty to MO tree view -->
    <record id="mrp_production_tree_view_certainty" model="ir.ui.view">
        <field name="name">mrp.production.tree.certainty</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="certainty"
                        widget="badge"
                        optional="show"
                    decoration-muted="certainty == '0'"
                    decoration-danger="certainty == '25'"
                    decoration-warning="certainty == '50'"
                    decoration-info="certainty == '75'"
                    decoration-success="certainty == '100'"/>
            </xpath>
        </field>
    </record>

    <!-- Add certainty to search view -->
    <record id="mrp_production_search_view_certainty" model="ir.ui.view">
        <field name="name">mrp.production.search.certainty</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.view_mrp_production_filter"/>
        <field name="arch" type="xml">
            <!-- Add search field -->
            <xpath expr="//field[@name='name']" position="after">
                <field name="certainty"/>
            </xpath>
            
            <!-- Add filters for different certainty levels -->
            <xpath expr="//filter[@name='todo']" position="after">
                <separator/>
                <filter string="Cancelled (0%)" 
                        name="cancelled_certainty" 
                        domain="[('certainty', '=', '0')]"
                        help="Cancelled manufacturing orders"/>
                <filter string="Uncertain (25-75%)" 
                        name="uncertain" 
                        domain="[('certainty', 'in', ['25', '50', '75'])]"
                        help="Manufacturing orders not yet confirmed"/>
                <filter string="Confirmed (100%)" 
                        name="certain" 
                        domain="[('certainty', '=', '100')]"
                        help="Confirmed manufacturing orders"/>
                <separator/>
                <filter string="0% Certainty" name="certainty_0" domain="[('certainty', '=', '0')]"/>
                <filter string="25% Certainty" name="certainty_25" domain="[('certainty', '=', '25')]"/>
                <filter string="50% Certainty" name="certainty_50" domain="[('certainty', '=', '50')]"/>
                <filter string="75% Certainty" name="certainty_75" domain="[('certainty', '=', '75')]"/>
                <filter string="100% Certainty" name="certainty_100" domain="[('certainty', '=', '100')]"/>
            </xpath>
            
            <!-- Add group by -->
            <xpath expr="//group" position="inside">
                <filter string="Certainty" name="groupby_certainty" context="{'group_by': 'certainty'}"/>
            </xpath>
        </field>
    </record>
</odoo>