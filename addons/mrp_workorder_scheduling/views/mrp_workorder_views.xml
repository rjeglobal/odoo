<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Calendar View using MO start date -->
    <record id="mrp_workorder_calendar_view_basic" model="ir.ui.view">
        <field name="name">mrp.workorder.calendar.basic</field>
        <field name="model">mrp.workorder</field>
        <field name="arch" type="xml">
            <calendar string="Work Order Schedule" 
                      date_start="mo_date_start"
                      color="workcenter_id"
                      mode="week"
                      event_open_popup="true"
                      quick_create="false"
                      create="false">
                <field name="name"/>
                <field name="production_id"/>
                <field name="workcenter_id" filters="1"/>
                <field name="state"/>
                <field name="duration_expected"/>
                <field name="mo_date_start"/>
            </calendar>
        </field>
    </record>

    <!-- Kanban View grouped by work center -->
    <record id="mrp_workorder_kanban_view_basic" model="ir.ui.view">
        <field name="name">mrp.workorder.kanban.basic</field>
        <field name="model">mrp.workorder</field>
        <field name="arch" type="xml">
            <kanban default_group_by="workcenter_id" quick_create="false" class="o_kanban_small_column">
                <field name="id"/>
                <field name="name"/>
                <field name="production_id"/>
                <field name="workcenter_id"/>
                <field name="mo_date_start"/>
                <field name="duration_expected"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="name"/>
                                        </strong>
                                        <div class="o_kanban_record_subtitle text-muted">
                                            MO: <field name="production_id"/>
                                        </div>
                                    </div>
                                    <div class="o_kanban_record_top_right">
                                        <field name="state" widget="badge"/>
                                    </div>
                                </div>
                                <div class="o_kanban_record_body">
                                    <div class="row mb-2">
                                        <div class="col-12">
                                            <i class="fa fa-industry"/> <field name="workcenter_id"/>
                                        </div>
                                    </div>
                                    <div class="row mb-2">
                                        <div class="col-6">
                                            <i class="fa fa-clock-o"/> <field name="duration_expected" widget="float_time"/>
                                        </div>
                                        <div class="col-6">
                                            <i class="fa fa-tasks"/> <field name="state"/>
                                        </div>
                                    </div>
                                    <t t-if="record.mo_date_start.raw_value">
                                        <div class="row">
                                            <div class="col-12 text-muted">
                                                <i class="fa fa-calendar"/> 
                                                <field name="mo_date_start" widget="date"/>
                                            </div>
                                        </div>
                                    </t>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Pivot View for Analysis -->
    <record id="mrp_workorder_pivot_view_basic" model="ir.ui.view">
        <field name="name">mrp.workorder.pivot.basic</field>
        <field name="model">mrp.workorder</field>
        <field name="arch" type="xml">
            <pivot string="Work Order Analysis">
                <field name="workcenter_id" type="row"/>
                <field name="mo_date_start" type="col" interval="week"/>
                <field name="duration_expected" type="measure"/>
                <field name="production_id" type="row"/>
            </pivot>
        </field>
    </record>

    <!-- Enhanced search view -->
    <record id="mrp_workorder_search_view_basic" model="ir.ui.view">
        <field name="name">mrp.workorder.search.basic</field>
        <field name="model">mrp.workorder</field>
        <field name="inherit_id" ref="mrp.view_mrp_production_work_order_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator/>
                <filter string="This Week" name="this_week"
                        domain="[('mo_date_start', '&gt;=', (context_today() + datetime.timedelta(days=-context_today().weekday())).strftime('%Y-%m-%d')), ('mo_date_start', '&lt;', (context_today() + datetime.timedelta(days=7-context_today().weekday())).strftime('%Y-%m-%d'))]"/>
                <filter string="Next Week" name="next_week"
                        domain="[('mo_date_start', '&gt;=', (context_today() + datetime.timedelta(days=7-context_today().weekday())).strftime('%Y-%m-%d')), ('mo_date_start', '&lt;', (context_today() + datetime.timedelta(days=14-context_today().weekday())).strftime('%Y-%m-%d'))]"/>
                
                <separator/>
                <filter string="Group by Work Center" name="group_by_workcenter" 
                        context="{'group_by': 'workcenter_id'}"/>
                <filter string="Group by Week" name="group_by_week" 
                        context="{'group_by': 'mo_date_start:week'}"/>
            </xpath>
        </field>
    </record>

    <!-- Kanban Action -->
    <record id="action_workorder_kanban" model="ir.actions.act_window">
        <field name="name">Work Order Kanban</field>
        <field name="res_model">mrp.workorder</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="view_id" ref="mrp_workorder_kanban_view_basic"/>
        <field name="search_view_id" ref="mrp_workorder_search_view_basic"/>
        <field name="domain">[('state', 'not in', ['done', 'cancel'])]</field>
        <field name="context">{'search_default_group_by_workcenter': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No work orders to manage
            </p>
            <p>
                Work orders will appear here grouped by work centers.
            </p>
        </field>
    </record>

    <!-- Calendar Action -->
    <record id="action_workorder_calendar" model="ir.actions.act_window">
        <field name="name">Work Order Calendar</field>
        <field name="res_model">mrp.workorder</field>
        <field name="view_mode">calendar,list,form</field>
        <field name="view_id" ref="mrp_workorder_calendar_view_basic"/>
        <field name="search_view_id" ref="mrp_workorder_search_view_basic"/>
        <field name="domain">[('state', 'not in', ['done', 'cancel'])]</field>
        <field name="context">{'search_default_group_by_workcenter': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No work orders scheduled
            </p>
            <p>
                Work orders will appear here when Manufacturing Orders have start dates.
            </p>
        </field>
    </record>

    <!-- Pivot Analysis Action -->
    <record id="action_workorder_analysis" model="ir.actions.act_window">
        <field name="name">Work Order Analysis</field>
        <field name="res_model">mrp.workorder</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="view_id" ref="mrp_workorder_pivot_view_basic"/>
        <field name="search_view_id" ref="mrp_workorder_search_view_basic"/>
        <field name="domain">[('state', 'not in', ['done', 'cancel'])]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No data to analyze
            </p>
            <p>
                Schedule work orders to see workload analysis.
            </p>
        </field>
    </record>

    <!-- Menu Items -->
    <menuitem id="menu_workorder_kanban"
              name="Work Order Kanban"
              parent="mrp.menu_mrp_manufacturing"
              action="action_workorder_kanban"
              sequence="19"/>

    <menuitem id="menu_workorder_calendar"
              name="Work Order Calendar"
              parent="mrp.menu_mrp_manufacturing"
              action="action_workorder_calendar"
              sequence="20"/>

    <menuitem id="menu_workorder_analysis"
              name="Work Order Analysis"
              parent="mrp.menu_mrp_manufacturing"
              action="action_workorder_analysis"
              sequence="21"/>

</odoo>